# ==============================================================================
# APIShield Breaker CTF — Environment Configuration
# Copy this file to .env before starting:  cp .env.example .env
# ==============================================================================

# Admin key to access the scoreboard projector & countdown timer:
# Access at https://ctf.apisecunigeria.com/admin?key=<YOUR_ADMIN_KEY>
ADMIN_KEY=summit2026-secret-change-me

# Domains (must match the DNS A records pointing to your VPS)
DOMAIN_CONSOLE=ctf.apisecunigeria.com
DOMAIN_TARGET=target.ctf.apisecunigeria.com

# Aegis target signing secret (keep as 'aegis' for standard F6 CTF challenge)
JWT_SECRET=aegis
